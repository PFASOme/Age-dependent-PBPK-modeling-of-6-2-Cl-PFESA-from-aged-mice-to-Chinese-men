; 6:2 Cl-PFESA PBPK -- V3 RECALIBRATION BASELINE
; Berkeley Madonna
; Time: h; amounts: mg; concentrations: mg/L
;
; Total plasma amount states.
; Plasma convection uses total concentrations.
; PTC efflux returns to the renal exchange pool.
; VPTCC is L/g kidney.
; Additional systemic parent loss is OFF by default.
; Inherited chemical parameters require recalibration.
; This baseline does not reproduce the observed half-life by definition.
; Renal RBC binding is neglected.
; Tissue density is approximated as 1 kg/L.
; Km_baso and Kdif are effective total-concentration parameters.
; They are not measured unbound Km or membrane permeability.
; KidneyPerfused must match the actual sampling protocol.

METHOD Stiff

; TIME SETTINGS

Starttime = 0
Stoptime = 2160

Exposure_days = 90
Exposure_stop_h = Exposure_days*24



DTMIN = 1e-7
DTMAX = 0.1
DTOUT = 1
TOLERANCE = 1e-7

; PHYSIOLOGY

BW = 0.034
BW_ref_kg = 1
BWratio = BW/BW_ref_kg

Htc = 0.48

VLC = 0.059
VKC = 0.014
VLuC = 0.0064
VBC = 0.016
VPlasC = 0.049

VL = VLC*BW
VK = VKC*BW
VLu = VLuC*BW
VBrain = VBC*BW
VPlas_total = VPlasC*BW

VfilC = 0.0014
Vfil = VfilC*BW

VPTCC = 0.000135
; L/g kidney
VPTC = VK*1000*VPTCC

FVBK = 0.24
VKblood = VK*FVBK
VKplasma = VKblood*(1-Htc)

VKpar = VK-VKblood-VPTC-Vfil

; Exclude explicitly represented renal plasma from central plasma.
VPlas = VPlas_total-VKplasma

MK = VK*1000
; g kidney, assuming density = 1 kg/L

; Renal subvolumes are already included in VK.
VRest = 0.93*BW-VL-VLu-VBrain-VK-VPlas

; PLASMA FLOW

QCC = 16.5
QLC = 0.161
QKC = 0.091
QLuC = 1
QBC = 0.033

QC = QCC*(BWratio^0.75)*(1-Htc)
QK = QKC*QC
QL = QLC*QC
QLu = QLuC*QC
QBrain = QBC*QC
QRest = QC-QK-QL-QBrain

Qbal = QC-QK-QL-QBrain-QRest

; PARTITION AND BINDING PARAMETERS
; Starting values requiring recalibration.

PL = 16.51
PLu = 3.91
PBrain = 0.11
PRest = 0.64

PK_exchange_seed = 1.38
; Approximate exchange-pool starting seed only.
; PTC and filtrate contributions are excluded from this initialization.
; This is not a fitted whole-kidney AUC ratio.

PKpar_start = (PK_exchange_seed*VK-VKplasma)/VKpar
PKpar_scale = 1
PKpar = PKpar_start*PKpar_scale

; PKpar: residual renal parenchyma/renal-plasma partition coefficient.
; Refit PKpar_scale or replace PKpar_start using renal observations.

MW = 532.58
Free = 0.0043

; RENAL TRANSPORT PARAMETERS

MKC = VKC

Vmax_baso_invitro = 1248.68
Km_baso = 354.22

Vmax_apical_invitro = 1808
Km_apical = 211.84

RAFbaso = 3.99
RAFapi = 2.81

GFRC = 59
Kdif = 0.00051
KeffluxC = 2.09
KurineC = 0.000016

protein = 2.0e-6

; GI AND BILIARY PARAMETERS

KabsC = 0.042
KunabsC = 0.00421
GEC = 0.540
K0C = 0.38
KbileC = 0.000999

; TRANSPORTER SCALING

PTC_cells_perkg = MKC*6e7*1000

Vmax_basoC = Vmax_baso_invitro*RAFbaso*PTC_cells_perkg*protein*60*(MW/1e12)*1000
Vmax_apicalC = Vmax_apical_invitro*RAFapi*PTC_cells_perkg*protein*60*(MW/1e12)*1000

Vmax_baso = Vmax_basoC*(BWratio^0.75)
Vmax_apical = Vmax_apicalC*(BWratio^0.75)

; FIRST-ORDER RATE SCALING

Kbile = KbileC*(BWratio^-0.25)
Kurine = KurineC*(BWratio^-0.25)
Kefflux = KeffluxC*(BWratio^-0.25)
Kabs = KabsC*(BWratio^-0.25)
Kunabs = KunabsC*(BWratio^-0.25)
GE = GEC*(BWratio^-0.25)
K0 = K0C*(BWratio^-0.25)

GFR = GFRC*(MK/1000)

; OPTIONAL ADDITIONAL SYSTEMIC PARENT LOSS

HL_target_day = 46.5
; Literature reference only.
; This value does not set Ksys.

Ksys_extra_h = 0
; Units: 1/h.
; Default zero is a recalibration baseline.
; If supported, estimate a nonnegative value jointly with explicit clearance.
; Do not set this automatically to LN(2)/(total half-life).

Ksys = Ksys_extra_h

; DAILY ORAL EXPOSURE

Dose_mgkgd = 0.1
; Change to 0.02 or 0.5 for the other experimental groups.

DOSEF53B = Dose_mgkgd*BW
doseF53B_int = 24

; Intended doses: t = 0,24,...,2136 h for 90 days.
; Close the gate between the last intended and next unwanted pulse.
Pulse_gate_stop_h = Exposure_stop_h-doseF53B_int/2

Dose_event_rate =
IF TIME < Pulse_gate_stop_h
THEN PULSE(1,0,doseF53B_int)
ELSE 0

DoseInput = DOSEF53B*Dose_event_rate

ADOSE' = DoseInput
INIT ADOSE = 0

DoseCount' = Dose_event_rate
INIT DoseCount = 0

Expected_dose_count = Exposure_stop_h/doseF53B_int
Expected_total_dose_mg = Expected_dose_count*DOSEF53B

Dose_count_error = DoseCount-Expected_dose_count

Dose_relative_error_pct =
IF Expected_total_dose_mg > 0
THEN 100*(ADOSE-Expected_total_dose_mg)/Expected_total_dose_mg
ELSE 0

; Interpret dose errors after the final intended pulse has completed.

; TOTAL PLASMA CONCENTRATIONS

CA = RA/(VPlas*0.2)
CV = RV/(VPlas*0.8)

CA_free = Free*CA
CV_free = Free*CV

Cplas = (RA+RV)/VPlas

; LIVER CONCENTRATIONS

CL = RL/VL
CVL = CL/PL
CVL_free = Free*CVL

; RENAL EXCHANGE AND OBSERVATION

Kidney_partition_den = VKplasma+PKpar*VKpar

CVK = RKE/Kidney_partition_den
CVK_free = Free*CVK

CKpar = PKpar*CVK
A_Kvascular = CVK*VKplasma
A_Kpar = CKpar*VKpar

Kidney_partition_check = RKE-A_Kvascular-A_Kpar
PK_exchange_actual = Kidney_partition_den/VK

CPTC = RPTC/VPTC
Cfil = RFil/Vfil

KidneyPerfused = 0
; 0: include renal vascular plasma in the observation.
; 1: subtract renal vascular plasma.
; Match the actual sampling protocol and wet-mass denominator.

Kidney_amount_observed = RKE+RPTC+RFil-KidneyPerfused*A_Kvascular
CK = Kidney_amount_observed/VK

Whole_kidney_to_CVK = IF CVK > 0 THEN CK/CVK ELSE 0

; LUNG, BRAIN AND REST CONCENTRATIONS

CLu = RLu/VLu
CVLu = CLu/PLu
CVLu_free = Free*CVLu

CBrain = RBrain/VBrain
CVBrain = CBrain/PBrain
CVBrain_free = Free*CVBrain

CRest = RRest/VRest
CVRest = CRest/PRest
CVRest_free = Free*CVRest

; RENAL TRANSPORT RATES

RA_baso = Vmax_baso*CVK/(Km_baso+CVK)
RA_apical = Vmax_apical*Cfil/(Km_apical+Cfil)

Rdif = Kdif*(CVK-CPTC)
RAefflux = Kefflux*RPTC
RCI = CA_free*GFR

A_baso' = RA_baso
INIT A_baso = 0

A_apical' = RA_apical
INIT A_apical = 0

A_dif' = Rdif
INIT A_dif = 0

A_efflux' = RAefflux
INIT A_efflux = 0

A_GFR' = RCI
INIT A_GFR = 0

; Cumulative renal transport is not irreversible elimination.

; ADDITIONAL LOSS ACCOUNTING

Systemic_mass_for_loss = RA+RV+RRest+RKE+RPTC+RL+RLu+RBrain
Rate_sysloss = Ksys*Systemic_mass_for_loss

Rsysloss' = Rate_sysloss
INIT Rsysloss = 0

; DIFFERENTIAL EQUATIONS

RV' = QRest*CVRest+QK*CVK+QL*CVL+QBrain*CVBrain-QLu*CV-Ksys*RV
INIT RV = 0

RA' = QLu*CVLu-QC*CA-Ksys*RA
INIT RA = 0

RKE' = QK*(CA-CVK)-RCI-Rdif-RA_baso+RAefflux-Ksys*RKE
INIT RKE = 0

RPTC' = Rdif+RA_apical+RA_baso-RAefflux-Ksys*RPTC
INIT RPTC = 0

RFil' = RCI-RA_apical-Kurine*RFil
INIT RFil = 0

Rurine' = Kurine*RFil
INIT Rurine = 0

RRest' = QRest*(CA-CVRest)-Ksys*RRest
INIT RRest = 0

RLu' = QLu*(CV-CVLu)-Ksys*RLu
INIT RLu = 0

RBrain' = QBrain*(CA-CVBrain)-Ksys*RBrain
INIT RBrain = 0

RST' = DoseInput-K0*RST-GE*RST
INIT RST = 0

RSI' = GE*RST-Kabs*RSI-Kunabs*RSI+Kbile*RL
INIT RSI = 0

RL' = QL*(CA-CVL)-Kbile*RL+Kabs*RSI+K0*RST-Ksys*RL
INIT RL = 0

Rfeces' = Kunabs*RSI
INIT Rfeces = 0

; INTERNAL TRANSFER DIAGNOSTICS

RabsST' = K0*RST
INIT RabsST = 0

RabsSI' = Kabs*RSI
INIT RabsSI = 0

Total_oral_uptake = RabsST+RabsSI

Rbile' = Kbile*RL
INIT Rbile = 0

; Biliary transfer enters the intestine and is not an additional terminal loss.

; AUC

AUCPlas' = Cplas
INIT AUCPlas = 0

AUCLiver' = CL
INIT AUCLiver = 0

AUCKidney' = CK
INIT AUCKidney = 0

AUCLung' = CLu
INIT AUCLung = 0

AUCBrain' = CBrain
INIT AUCBrain = 0

; MASS BALANCE

Tmass = RA+RV+RRest+RKE+RFil+RPTC+RL+RST+RSI+RLu+RBrain
Loss = Rurine+Rfeces+Rsysloss
Input = ADOSE

Bal = Input-Tmass-Loss

Mass_recovery_pct =
IF Input > 0
THEN 100*(Tmass+Loss)/Input
ELSE 0

Mass_balance_abs_error_pct =
IF Input > 0
THEN 100*ABS(Bal)/Input
ELSE 0

Day = TIME/24

Liver_amount_ug = RL*1000
Urine_loss_ug = Rurine*1000
Fecal_loss_ug = Rfeces*1000
Systemic_lumped_loss_ug = Rsysloss*1000

; Rsysloss is not a measured metabolic pathway.

; DEPURATION DIAGNOSTICS

PostStop_day = (TIME-Exposure_stop_h)/24
ln_Cplas = IF Cplas > 0 THEN LOGN(Cplas) ELSE -999

; OUTPUTS

VP = CV
AP = CA

Plas = Cplas
Plas_ng_mL = Cplas*1000

Liver = CL
Liver_ng_g = CL*1000

Kidney = CK
Kidney_ng_g = CK*1000

Kidney_parenchyma = CKpar
Kidney_parenchyma_ng_g = CKpar*1000

Kidney_venous_plasma = CVK
Kidney_venous_plasma_ng_mL = CVK*1000

PTC_conc = CPTC
Filtrate = Cfil

Lung = CLu
Lung_ng_g = CLu*1000

Brain = CBrain
Brain_ng_g = CBrain*1000

Rest = CRest

; END MOUSE MODEL

