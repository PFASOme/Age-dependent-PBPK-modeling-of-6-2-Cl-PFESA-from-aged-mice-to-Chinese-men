
; 6:2 Cl-PFESA HUMAN PBPK -- V3 MONTE CARLO (8 influential parameters)
; Berkeley Madonna
; Time: h; amounts: mg; concentrations: mg/L
;
; Default exposure: age 20 to 65, once every 24 h.
; Physiological age always equals chronological age.
; No age-freezing switch.
; Total plasma amount states and total-concentration convection.
; PTC efflux returns to the renal exchange pool.
; VPTCC is L/g kidney.
; Additional systemic parent loss is OFF by default.
; Monte Carlo uncertainty is propagated for 8 sensitivity-selected inputs.
; This baseline does not claim to reproduce the observed half-life.
; Renal RBC binding is neglected.
; Tissue density is approximated as 1 kg/L.
; Km_baso and Kdif are effective total-concentration parameters.
; They are not measured unbound Km or membrane permeability.

METHOD Stiff

; TIME AND AGE

Starttime = 0

Age_start_year = 20
Age_end_year = 65
Exposure_start_age = 20

Stoptime = 394200

DTMIN = 1e-7
DTMAX = 1
DTOUT = 24
TOLERANCE = 1e-8

Age_year = Age_start_year+TIME/(365*24)
Age_phys = Age_year

KidneyPerfused = 0

; PHYSIOLOGICAL MULTIPLIERS
; Default = 1; retain physiologically valid positive values.

mBW = 1
mHT = 1
mVB = 1
mVLu = 1
mQC = 1
mQBC = 1
mQKC = 1
mQLC = 1
meGFR = 1

; MONTE CARLO PARAMETERS 1-2: organ-volume trajectory scale factors
; Old 10001 sentinel convention is retained.
; These correspond to sensitivity labels VLC and VKC.
; Do NOT sample the derived VLC=VL/BW or VKC=VK/BW algebraically.
; Instead sample one individual-specific multiplier and apply it to the
; complete age-dependent organ-volume trajectory from age 20 to 65.
;
; Normal(mean=1, SD=0.30), accepted range 0.4120-1.5880.
; Out-of-range draws are coded as 10001 and excluded after simulation.
VLC_scalec = init(normal(1,0.30))
VLC_scale = IF (VLC_scalec > 0.4120) AND (VLC_scalec < 1.5880) THEN VLC_scalec ELSE 10001
VLC_scale_used = IF VLC_scale = 10001 THEN 1 ELSE VLC_scale

VKC_scalec = init(normal(1,0.30))
VKC_scale = IF (VKC_scalec > 0.4120) AND (VKC_scalec < 1.5880) THEN VKC_scalec ELSE 10001
VKC_scale_used = IF VKC_scale = 10001 THEN 1 ELSE VKC_scale

; AGE-DEPENDENT ANTHROPOMETRY

BW_phys_base =
IF Age_phys <= 22.5 THEN 70.4
ELSE IF Age_phys <= 27.5 THEN 70.4+(72.8-70.4)*(Age_phys-22.5)/5
ELSE IF Age_phys <= 32.5 THEN 72.8+(74.3-72.8)*(Age_phys-27.5)/5
ELSE IF Age_phys <= 37.5 THEN 74.3+(74.0-74.3)*(Age_phys-32.5)/5
ELSE IF Age_phys <= 42.5 THEN 74.0+(73.2-74.0)*(Age_phys-37.5)/5
ELSE IF Age_phys <= 47.5 THEN 73.2+(72.5-73.2)*(Age_phys-42.5)/5
ELSE IF Age_phys <= 52.5 THEN 72.5+(71.6-72.5)*(Age_phys-47.5)/5
ELSE IF Age_phys <= 57.5 THEN 71.6+(71.0-71.6)*(Age_phys-52.5)/5
ELSE IF Age_phys <= 62.5 THEN 71.0+(69.0-71.0)*(Age_phys-57.5)/5
ELSE IF Age_phys <= 67.5 THEN 69.0+(68.1-69.0)*(Age_phys-62.5)/5
ELSE IF Age_phys <= 72.5 THEN 68.1+(66.7-68.1)*(Age_phys-67.5)/5
ELSE IF Age_phys <= 77.5 THEN 66.7+(65.0-66.7)*(Age_phys-72.5)/5
ELSE 65.0

HT_phys_base =
IF Age_phys <= 22.5 THEN 172.6
ELSE IF Age_phys <= 27.5 THEN 172.6+(172.1-172.6)*(Age_phys-22.5)/5
ELSE IF Age_phys <= 32.5 THEN 172.1+(171.4-172.1)*(Age_phys-27.5)/5
ELSE IF Age_phys <= 37.5 THEN 171.4+(170.4-171.4)*(Age_phys-32.5)/5
ELSE IF Age_phys <= 42.5 THEN 170.4+(169.4-170.4)*(Age_phys-37.5)/5
ELSE IF Age_phys <= 47.5 THEN 169.4+(168.7-169.4)*(Age_phys-42.5)/5
ELSE IF Age_phys <= 52.5 THEN 168.7+(167.9-168.7)*(Age_phys-47.5)/5
ELSE IF Age_phys <= 57.5 THEN 167.9+(167.5-167.9)*(Age_phys-52.5)/5
ELSE IF Age_phys <= 62.5 THEN 167.5+(165.9-167.5)*(Age_phys-57.5)/5
ELSE IF Age_phys <= 67.5 THEN 165.9+(165.4-165.9)*(Age_phys-62.5)/5
ELSE IF Age_phys <= 72.5 THEN 165.4+(164.6-165.4)*(Age_phys-67.5)/5
ELSE IF Age_phys <= 77.5 THEN 164.6+(164.2-164.6)*(Age_phys-72.5)/5
ELSE 164.2

BW = mBW*BW_phys_base
HT = mHT*HT_phys_base

BW_dose = BW
BW_ref_kg = 1
BWratio = BW/BW_ref_kg

SA = 0.007184*(BW^0.425)*(HT^0.725)

; AGE-DEPENDENT ORGAN VOLUMES

VL_pred = -0.0143744-0.0044728*Age_phys+0.0264591*BW
VB_pred = 0.218096-0.001590*Age_phys-0.003274*BW+0.008626*HT
VK_pred = 0.05668-0.0004962*Age_phys+0.003501*BW
VLu_pred = -0.01454+0.0007269*Age_phys+9.329E-6*Age_phys^2+0.006430*BW+3.083E-5*BW^2

VL = VLC_scale_used*VL_pred
VB = mVB*VB_pred
VK = VKC_scale_used*VK_pred
VLu = mVLu*VLu_pred

; CARDIAC OUTPUT AND PLASMA VOLUMES

QC_blood_pred = 6.48370-1.59948*Age_phys+214.68572*SA
QC_blood = mQC*QC_blood_pred

Htc = 0.44

VPlasC = 0.0428
VPlas_total = VPlasC*BW

Vfil = 0.10*VK

VPTCC = 0.000135
; L/g kidney
VPTC = VK*1000*VPTCC

FVBK = 0.24
VKblood = VK*FVBK
VKplasma = VKblood*(1-Htc)

VKpar = VK-VKblood-VPTC-Vfil

; Central plasma excludes explicitly represented renal plasma.
VPlas = VPlas_total-VKplasma

; AGE-DEPENDENT ORGAN BLOOD FLOWS

QBC50 = 0.12
QKC50 = 0.19
QLC50 = 0.255

QB_ref_mL_min =
IF Age_phys <= 50 THEN 727.9
ELSE IF Age_phys <= 60 THEN 727.9+(692.9-727.9)*(Age_phys-50)/10
ELSE IF Age_phys <= 70 THEN 692.9+(650.6-692.9)*(Age_phys-60)/10
ELSE IF Age_phys <= 80 THEN 650.6+(623.8-650.6)*(Age_phys-70)/10
ELSE IF Age_phys <= 90 THEN 623.8+(594.4-623.8)*(Age_phys-80)/10
ELSE IF Age_phys <= 100 THEN 594.4+(536.1-594.4)*(Age_phys-90)/10
ELSE 536.1

QB_age_factor = QB_ref_mL_min/727.9

QK_ref_mL_min =
IF Age_phys <= 50 THEN 1116.3
ELSE IF Age_phys <= 60 THEN 1116.3+(913.3-1116.3)*(Age_phys-50)/10
ELSE IF Age_phys <= 70 THEN 913.3+(730.3-913.3)*(Age_phys-60)/10
ELSE IF Age_phys <= 80 THEN 730.3+(567.3-730.3)*(Age_phys-70)/10
ELSE IF Age_phys <= 90 THEN 567.3+(424.3-567.3)*(Age_phys-80)/10
ELSE IF Age_phys <= 100 THEN 424.3+(301.3-424.3)*(Age_phys-90)/10
ELSE 301.3

QK_age_factor = QK_ref_mL_min/1116.3

QL_ref_mL_min =
IF Age_phys <= 50 THEN 1661.6
ELSE IF Age_phys <= 60 THEN 1661.6+(1418.6-1661.6)*(Age_phys-50)/10
ELSE IF Age_phys <= 70 THEN 1418.6+(1091.6-1418.6)*(Age_phys-60)/10
ELSE IF Age_phys <= 80 THEN 1091.6+(819.7-1091.6)*(Age_phys-70)/10
ELSE IF Age_phys <= 90 THEN 819.7+(688.6-819.7)*(Age_phys-80)/10
ELSE IF Age_phys <= 100 THEN 688.6+(555.1-688.6)*(Age_phys-90)/10
ELSE 555.1

QL_age_factor = QL_ref_mL_min/1661.6

QBC = mQBC*QBC50*QB_age_factor
QKC = mQKC*QKC50*QK_age_factor
QLC = mQLC*QLC50*QL_age_factor

QB_blood = QBC*QC_blood
QK_blood = QKC*QC_blood
QL_blood = QLC*QC_blood

QC = QC_blood*(1-Htc)
QB = QB_blood*(1-Htc)
QK = QK_blood*(1-Htc)
QL = QL_blood*(1-Htc)

QLu = QC
QRest = QC-QL-QK-QB

; AGE-DEPENDENT RENAL FILTRATION

eGFR_base =
IF Age_phys <= 24.5 THEN 113.94
ELSE IF Age_phys <= 34.5 THEN 113.94+(106.93-113.94)*(Age_phys-24.5)/10
ELSE IF Age_phys <= 44.5 THEN 106.93+(100.31-106.93)*(Age_phys-34.5)/10
ELSE IF Age_phys <= 54.5 THEN 100.31+(96.32-100.31)*(Age_phys-44.5)/10
ELSE IF Age_phys <= 64.5 THEN 96.32+(88.63-96.32)*(Age_phys-54.5)/10
ELSE IF Age_phys <= 74.5 THEN 88.63+(82.76-88.63)*(Age_phys-64.5)/10
ELSE 82.76

eGFR = meGFR*eGFR_base
GFR_mL_min = eGFR*SA/1.73
GFR = GFR_mL_min*60/1000
GFRC = GFR/VK

; REST-OF-BODY VOLUME

VRest = 0.93*BW-VL-VLu-VB-VK-VPlas

VLC = VL/BW
VKC = VK/BW
VLuC = VLu/BW
VBC = VB/BW
VfilC = Vfil/BW

QCC_equiv = QC_blood/(BWratio^0.75)

; PARTITION AND BINDING PARAMETERS
; MONTE CARLO PARAMETERS 3-4: PL and PRest.
; Old 10001 sentinel convention is retained.
; Log-normal distributions use CV = 0.20 and 2.5th-97.5th acceptance bounds.

PLc = init(exp(normal(2.714757153,0.198042200)))
PL = IF (PLc > 10.242999) AND (PLc < 22.262861) THEN PLc ELSE 10001
PL_used = IF PL = 10001 THEN 15.40 ELSE PL

PK_exchange_seed = 1.38
; Approximate exchange-pool starting seed only.
; PTC and filtrate contributions are excluded from this initialization.
; This is not a fitted whole-kidney AUC ratio.

PKpar_start = (PK_exchange_seed*VK-VKplasma)/VKpar
PKpar_scale = 1
PKpar = PKpar_start*PKpar_scale

PLu = 5.02
PB = 0.14


PRestc = init(exp(normal(-1.159044640,0.198042200)))
PRest = IF (PRestc > 0.212842) AND (PRestc < 0.462605) THEN PRestc ELSE 10001
PRest_used = IF PRest = 10001 THEN 0.32 ELSE PRest

MW = 532.58
Free = 0.0043

; RENAL TRANSPORT PARAMETERS
; MONTE CARLO PARAMETERS 5-8:
; Vmax_baso_invitro, Km_baso, RAFbaso, and KeffluxC.
; Old 10001 sentinel convention is retained.
; Log-normal distributions use CV = 0.20 and 2.5th-97.5th acceptance bounds.

Vmax_baso_invitroc = init(exp(normal(6.152090241,0.198042200)))
Vmax_baso_invitro = IF (Vmax_baso_invitroc > 318.597174) AND (Vmax_baso_invitroc < 692.461717) THEN Vmax_baso_invitroc ELSE 10001
Vmax_baso_invitro_used = IF Vmax_baso_invitro = 10001 THEN 479 ELSE Vmax_baso_invitro

Km_basoc = init(exp(normal(2.981109458,0.198042200)))
Km_baso = IF (Km_basoc > 13.369109) AND (Km_basoc < 29.057371) THEN Km_basoc ELSE 10001
Km_baso_used = IF Km_baso = 10001 THEN 20.1 ELSE Km_baso

Vmax_apical_invitro = 51803
Km_apical = 64.4

RAFbasoc = init(exp(normal(-0.019610357,0.198042200)))
RAFbaso = IF (RAFbasoc > 0.665130) AND (RAFbasoc < 1.445640) THEN RAFbasoc ELSE 10001
RAFbaso_used = IF RAFbaso = 10001 THEN 1 ELSE RAFbaso

RAFapi = 0.001

Kdif = 0.001

KeffluxCc = init(exp(normal(0.717553709,0.198042200)))
KeffluxC = IF (KeffluxCc > 1.390121) AND (KeffluxCc < 3.021388) THEN KeffluxCc ELSE 10001
KeffluxC_used = IF KeffluxC = 10001 THEN 2.09 ELSE KeffluxC

KurineC = 0.000016

protein = 2.0E-6

; GI AND BILIARY PARAMETERS

KabsC = 0.05
KunabsC = 0.000853
K0C = 0.38
KbileC = 0.000136
GEC = 3.5

; TRANSPORTER SCALING

PTC_cells_perkg = VKC*1000*6E7

Vmax_basoC = Vmax_baso_invitro_used*RAFbaso_used*PTC_cells_perkg*protein*60*(MW/1E12)*1000
Vmax_apicalC = Vmax_apical_invitro*RAFapi*PTC_cells_perkg*protein*60*(MW/1E12)*1000

Vmax_baso = Vmax_basoC*(BWratio^0.75)
Vmax_apical = Vmax_apicalC*(BWratio^0.75)

; FIRST-ORDER RATE SCALING

Kbile = KbileC*(BWratio^-0.25)
Kurine = KurineC*(BWratio^-0.25)
Kefflux = KeffluxC_used*(BWratio^-0.25)
Kabs = KabsC*(BWratio^-0.25)
Kunabs = KunabsC*(BWratio^-0.25)
GE = GEC*(BWratio^-0.25)
K0 = K0C*(BWratio^-0.25)

; OPTIONAL ADDITIONAL SYSTEMIC PARENT LOSS

HL_target_day = 5588
; Literature reference only.
; This value does not set Ksys.

Ksys_extra_h = 0
; Units: 1/h.
; Default zero is a recalibration baseline.
; Estimate jointly with explicit clearance only if supported.
; Do not set automatically from total terminal half-life.

Ksys = Ksys_extra_h

; INITIAL BACKGROUND BURDEN AT AGE 20
; Background concentration is an assumed starting condition.
; Tissue states start in partition equilibrium.
; PTC and filtrate initial amounts are zero.

C0_plasma_ng_mL = 0.57
C0_plasma_mg_L = C0_plasma_ng_mL/1000

C0_liver_mg_L = PL_used*C0_plasma_mg_L
C0_kidney_par_mg_L = PKpar*C0_plasma_mg_L
C0_lung_mg_L = PLu*C0_plasma_mg_L
C0_brain_mg_L = PB*C0_plasma_mg_L
C0_rest_mg_L = PRest_used*C0_plasma_mg_L

RKE0 = C0_plasma_mg_L*VKplasma+C0_kidney_par_mg_L*VKpar

; AGE-STRATIFIED DAILY EXPOSURE

Dose18_50_mgkgd = 1.22E-7
Dose50_65_mgkgd = Dose18_50_mgkgd*(2450/2600)
Dose65_80_mgkgd = Dose18_50_mgkgd*(2350/2600)

Dose_mgkgd =
IF Age_year < 50 THEN Dose18_50_mgkgd
ELSE IF Age_year < 65 THEN Dose50_65_mgkgd
ELSE Dose65_80_mgkgd

Exposure_on = IF Age_year < Exposure_start_age THEN 0 ELSE 1
Daily_dose_mg = Exposure_on*Dose_mgkgd*BW_dose

Dose_interval_h = 24
Exposure_start_h = (Exposure_start_age-Age_start_year)*365*24

; Require Age_start_year <= Exposure_start_age < Age_end_year.
; Default ages correspond to an integer number of exposure days.

Pulse_gate_stop_h = Stoptime-Dose_interval_h/2

Dose_event_rate =
IF TIME < Pulse_gate_stop_h
THEN PULSE(1,Exposure_start_h,Dose_interval_h)
ELSE 0

DoseInput = Daily_dose_mg*Dose_event_rate

ADOSE' = DoseInput
INIT ADOSE = 0

DoseCount' = Dose_event_rate
INIT DoseCount = 0

Expected_dose_count = (Stoptime-Exposure_start_h)/Dose_interval_h
Dose_count_error = DoseCount-Expected_dose_count

; Interpret dose-count error at the simulation endpoint.
; Default: 16425 doses, final dose 24 h before the endpoint.

; TOTAL PLASMA CONCENTRATIONS

CA = RA/(VPlas*0.2)
CV = RV/(VPlas*0.8)

CA_free = Free*CA
CV_free = Free*CV

Cplas = (RA+RV)/VPlas

; LIVER CONCENTRATIONS

CL = RL/VL
CVL = CL/PL_used
CVL_free = Free*CVL

; RENAL EXCHANGE AND OBSERVATION

Kidney_partition_den = VKplasma+PKpar*VKpar

CVK = RKE/Kidney_partition_den
CVK_free = Free*CVK

CKpar = PKpar*CVK
A_Kvascular = CVK*VKplasma
A_Kpar = CKpar*VKpar

Kidney_partition_check = RKE-A_Kvascular-A_Kpar
PK_exchange_actual = Kidney_partition_den/VK

CPTC = RPTC/VPTC
Cfil = RFil/Vfil

Kidney_amount_observed = RKE+RPTC+RFil-KidneyPerfused*A_Kvascular
CK = Kidney_amount_observed/VK

Whole_kidney_to_CVK = IF CVK > 0 THEN CK/CVK ELSE 0

; LUNG, BRAIN AND REST CONCENTRATIONS

CLu = RLu/VLu
CVLu = CLu/PLu
CVLu_free = Free*CVLu

CB = RB/VB
CVB = CB/PB
CVB_free = Free*CVB

CRest = RRest/VRest
CVRest = CRest/PRest_used
CVRest_free = Free*CVRest

; RENAL TRANSPORT RATES

Rate_baso = Vmax_baso*CVK/(Km_baso_used+CVK)
Rate_apical = Vmax_apical*Cfil/(Km_apical+Cfil)

Rate_dif = Kdif*(CVK-CPTC)
Rate_efflux = Kefflux*RPTC
Rate_GFR = CA_free*GFR

Cum_baso' = Rate_baso
INIT Cum_baso = 0

Cum_apical' = Rate_apical
INIT Cum_apical = 0

Cum_dif' = Rate_dif
INIT Cum_dif = 0

Cum_efflux' = Rate_efflux
INIT Cum_efflux = 0

Cum_GFR' = Rate_GFR
INIT Cum_GFR = 0

; Cumulative renal transport is not irreversible elimination.

; ADDITIONAL LOSS ACCOUNTING

Systemic_mass_for_loss = RA+RV+RRest+RKE+RPTC+RL+RLu+RB
Rate_sysloss = Ksys*Systemic_mass_for_loss

Rsysloss' = Rate_sysloss
INIT Rsysloss = 0

; DIFFERENTIAL EQUATIONS

RV' = QRest*CVRest+QK*CVK+QL*CVL+QB*CVB-QLu*CV-Ksys*RV
INIT RV = C0_plasma_mg_L*VPlas*0.8

RA' = QLu*CVLu-QC*CA-Ksys*RA
INIT RA = C0_plasma_mg_L*VPlas*0.2

RKE' = QK*(CA-CVK)-Rate_GFR-Rate_dif-Rate_baso+Rate_efflux-Ksys*RKE
INIT RKE = RKE0

RPTC' = Rate_dif+Rate_apical+Rate_baso-Rate_efflux-Ksys*RPTC
INIT RPTC = 0

RFil' = Rate_GFR-Rate_apical-Kurine*RFil
INIT RFil = 0

Rurine' = Kurine*RFil
INIT Rurine = 0

RRest' = QRest*(CA-CVRest)-Ksys*RRest
INIT RRest = C0_rest_mg_L*VRest

RLu' = QLu*(CV-CVLu)-Ksys*RLu
INIT RLu = C0_lung_mg_L*VLu

RB' = QB*(CA-CVB)-Ksys*RB
INIT RB = C0_brain_mg_L*VB

RST' = DoseInput-K0*RST-GE*RST
INIT RST = 0

RSI' = GE*RST-Kabs*RSI-Kunabs*RSI+Kbile*RL
INIT RSI = 0

RL' = QL*(CA-CVL)-Kbile*RL+Kabs*RSI+K0*RST-Ksys*RL
INIT RL = C0_liver_mg_L*VL

Rfeces' = Kunabs*RSI
INIT Rfeces = 0

; INTERNAL TRANSFER DIAGNOSTICS

RabsST' = K0*RST
INIT RabsST = 0

RabsSI' = Kabs*RSI
INIT RabsSI = 0

Total_oral_uptake = RabsSI+RabsST

Rbile' = Kbile*RL
INIT Rbile = 0

; Biliary transfer enters the intestine.
; Do not add Rbile again to terminal loss.

; INITIAL BURDEN AND MASS BALANCE

Qbal = QC-QL-QK-QRest-QB

Tmass = RA+RV+RRest+RKE+RFil+RPTC+RL+RST+RSI+RLu+RB
Loss = Rurine+Rfeces+Rsysloss

Initial_body_burden' = 0
INIT Initial_body_burden = C0_plasma_mg_L*VPlas+RKE0+C0_rest_mg_L*VRest+C0_liver_mg_L*VL+C0_lung_mg_L*VLu+C0_brain_mg_L*VB

Input = Initial_body_burden+ADOSE
Bal = Input-Tmass-Loss

Mass_recovery_pct =
IF Input > 0
THEN 100*(Tmass+Loss)/Input
ELSE 0

Mass_balance_abs_error_pct =
IF Input > 0
THEN 100*ABS(Bal)/Input
ELSE 0

ln_Cplas = IF Cplas > 0 THEN LOGN(Cplas) ELSE -999
; No terminal half-life is estimated from this daily-exposure main run.

; OUTPUTS

VP = CV
AP = CA

BW_output_kg = BW
BW_dose_output_kg = BW_dose
HT_output_cm = HT

Age_year_output = Age_year
Age_phys_output = Age_phys

Dose_mgkgd_output = Dose_mgkgd
Dose_ngkgd_output = Dose_mgkgd*1E6

C0_plasma_ng_mL_output = C0_plasma_ng_mL

eGFR_output = eGFR
GFR_mL_min_output = GFR_mL_min
GFRC_output = GFRC

QC_blood_output_L_h = QC_blood
QL_blood_output_L_h = QL_blood
QK_blood_output_L_h = QK_blood
QB_blood_output_L_h = QB_blood

QLC_output = QLC
QKC_output = QKC
QBC_output = QBC
QRest_output_L_h = QRest

Plas = Cplas
Plas_ng_mL = Plas*1000

Liver = CL
Liver_ng_g = Liver*1000

Kidney = CK
Kidney_ng_g = Kidney*1000

Kidney_parenchyma = CKpar
Kidney_parenchyma_ng_g = CKpar*1000

Lung = CLu
Lung_ng_g = Lung*1000

Brain = CB
Brain_ng_g = Brain*1000

Rest = CRest
Rest_ng_g = Rest*1000

; MONTE CARLO AGE-65 ENDPOINTS AND PARAMETER RECORDS
; At STOPTIME these equal the age-65 predictions.

MC_Plasma65_ng_mL = Plas_ng_mL
MC_Liver65_ng_g = Liver_ng_g
MC_Kidney65_ng_g = Kidney_ng_g
MC_Lung65_ng_g = Lung_ng_g
MC_Brain65_ng_g = Brain_ng_g

MC_VLC_scale = VLC_scale
MC_VKC_scale = VKC_scale
MC_PL = PL
MC_PRest = PRest
MC_Vmax_baso_invitro = Vmax_baso_invitro
MC_Km_baso = Km_baso
MC_RAFbaso = RAFbaso
MC_KeffluxC = KeffluxC

MC_VLC_scale_used = VLC_scale_used
MC_VKC_scale_used = VKC_scale_used
MC_PL_used = PL_used
MC_PRest_used = PRest_used
MC_Vmax_baso_invitro_used = Vmax_baso_invitro_used
MC_Km_baso_used = Km_baso_used
MC_RAFbaso_used = RAFbaso_used
MC_KeffluxC_used = KeffluxC_used

MC_valid =
IF VLC_scale = 10001 OR VKC_scale = 10001 OR PL = 10001 OR PRest = 10001 OR Vmax_baso_invitro = 10001 OR Km_baso = 10001 OR RAFbaso = 10001 OR KeffluxC = 10001 THEN 0
ELSE 1

MC_mass_balance_error_pct = Mass_balance_abs_error_pct
MC_mass_recovery_pct = Mass_recovery_pct

;======================================================================
; MONTE CARLO DESIGN -- OLD 10001 SENTINEL CONVENTION
;======================================================================
; Each of the eight parameters is sampled ONCE at initialization and retained
; throughout the age-20-to-65 trajectory for one virtual individual.
;
; Parameters and distributions:
;   VLC_scale: Normal(mean=1, SD=0.30), accept 0.4120-1.5880
;   VKC_scale: Normal(mean=1, SD=0.30), accept 0.4120-1.5880
;   PL: Lognormal(arithmetic mean=15.40, CV=0.20), accept 10.242999-22.262861
;   PRest: Lognormal(arithmetic mean=0.32, CV=0.20), accept 0.212842-0.462605
;   Vmax_baso_invitro: Lognormal(arithmetic mean=479, CV=0.20), accept 318.597174-692.461717
;   Km_baso: Lognormal(arithmetic mean=20.1, CV=0.20), accept 13.369109-29.057371
