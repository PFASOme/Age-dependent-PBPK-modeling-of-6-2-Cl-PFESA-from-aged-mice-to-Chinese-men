

; 6:2 Cl-PFESA HUMAN PBPK -- MC SIX PARAMETERS
; Berkeley Madonna
; Time: h; amounts: mg; concentrations: mg/L
;
; Exposure: age 20 to 65, once every 24 h.
; Physiological age equals chronological age.
; Post-50 organ flows use age-50 absolute-flow anchors.
; Total plasma amount states and total-concentration convection.
; PTC efflux returns to the renal exchange pool.
; VPTCC is L/g kidney.
; Additional systemic parent loss is OFF.
; Nominal inputs follow the latest supplied human-model parameter set.
; Renal RBC binding is neglected.
; Tissue density is approximated as 1 kg/L.
; Km_baso and Kdif are effective total-concentration parameters.
;
; MC parameters:
; VL_scale, PL, PRest, KbileC, KabsC, KunabsC.
;
; VL_scale: truncated normal, parent mean = 1, CV = 30%.
; Other five parameters:
; truncated log-normal, parent CV = 20%.
;
; Each parameter is sampled once per run.
; Parameter values remain fixed within each run.
; Age-dependent physiology continues to change.

METHOD Stiff

; TIME AND AGE

Starttime = 0

Age_start_year = 20
Age_end_year = 65
Exposure_start_age = 20

Stoptime = 394200

DTMIN = 1e-7
DTMAX = 1
DTOUT = 8760
TOLERANCE = 1e-8

Age_year = Age_start_year+TIME/(365*24)
Age_phys = Age_year

KidneyPerfused = 0

; PHYSIOLOGICAL MULTIPLIERS
; Keep these at 1 for the current MC design.

mBW = 1
mHT = 1

mVL = 1
mVB = 1
mVK = 1
mVLu = 1

mQC = 1
mQBC = 1
mQKC = 1
mQLC = 1

meGFR = 1

PL_scale = 1
PRest_scale = 1

; AGE-DEPENDENT ANTHROPOMETRY

BW_phys_base =
IF Age_phys <= 22.5 THEN 70.4
ELSE IF Age_phys <= 27.5 THEN 70.4+(72.8-70.4)*(Age_phys-22.5)/5
ELSE IF Age_phys <= 32.5 THEN 72.8+(74.3-72.8)*(Age_phys-27.5)/5
ELSE IF Age_phys <= 37.5 THEN 74.3+(74.0-74.3)*(Age_phys-32.5)/5
ELSE IF Age_phys <= 42.5 THEN 74.0+(73.2-74.0)*(Age_phys-37.5)/5
ELSE IF Age_phys <= 47.5 THEN 73.2+(72.5-73.2)*(Age_phys-42.5)/5
ELSE IF Age_phys <= 52.5 THEN 72.5+(71.6-72.5)*(Age_phys-47.5)/5
ELSE IF Age_phys <= 57.5 THEN 71.6+(71.0-71.6)*(Age_phys-52.5)/5
ELSE IF Age_phys <= 62.5 THEN 71.0+(69.0-71.0)*(Age_phys-57.5)/5
ELSE IF Age_phys <= 67.5 THEN 69.0+(68.1-69.0)*(Age_phys-62.5)/5
ELSE IF Age_phys <= 72.5 THEN 68.1+(66.7-68.1)*(Age_phys-67.5)/5
ELSE IF Age_phys <= 77.5 THEN 66.7+(65.0-66.7)*(Age_phys-72.5)/5
ELSE 65.0

HT_phys_base =
IF Age_phys <= 22.5 THEN 172.6
ELSE IF Age_phys <= 27.5 THEN 172.6+(172.1-172.6)*(Age_phys-22.5)/5
ELSE IF Age_phys <= 32.5 THEN 172.1+(171.4-172.1)*(Age_phys-27.5)/5
ELSE IF Age_phys <= 37.5 THEN 171.4+(170.4-171.4)*(Age_phys-32.5)/5
ELSE IF Age_phys <= 42.5 THEN 170.4+(169.4-170.4)*(Age_phys-37.5)/5
ELSE IF Age_phys <= 47.5 THEN 169.4+(168.7-169.4)*(Age_phys-42.5)/5
ELSE IF Age_phys <= 52.5 THEN 168.7+(167.9-168.7)*(Age_phys-47.5)/5
ELSE IF Age_phys <= 57.5 THEN 167.9+(167.5-167.9)*(Age_phys-52.5)/5
ELSE IF Age_phys <= 62.5 THEN 167.5+(165.9-167.5)*(Age_phys-57.5)/5
ELSE IF Age_phys <= 67.5 THEN 165.9+(165.4-165.9)*(Age_phys-62.5)/5
ELSE IF Age_phys <= 72.5 THEN 165.4+(164.6-165.4)*(Age_phys-67.5)/5
ELSE IF Age_phys <= 77.5 THEN 164.6+(164.2-164.6)*(Age_phys-72.5)/5
ELSE 164.2

BW = mBW*BW_phys_base
HT = mHT*HT_phys_base

BW_dose = BW

BW_ref_kg = 1
BWratio = BW/BW_ref_kg

SA = 0.007184*(BW^0.425)*(HT^0.725)

; AGE-DEPENDENT ORGAN VOLUMES

VL_pred = -0.0143744-0.0044728*Age_phys+0.0264591*BW

VB_pred = 0.218096-0.001590*Age_phys-0.003274*BW+0.008626*HT

VK_pred = 0.05668-0.0004962*Age_phys+0.003501*BW

VLu_pred = -0.01454+0.0007269*Age_phys+9.329E-6*Age_phys^2+0.006430*BW+3.083E-5*BW^2

VL = VL_scale*mVL*VL_pred
VB = mVB*VB_pred
VK = mVK*VK_pred
VLu = mVLu*VLu_pred

; CARDIAC OUTPUT AND PLASMA VOLUMES

QC_blood_pred = 6.48370-1.59948*Age_phys+214.68572*SA
QC_blood = mQC*QC_blood_pred

Htc = 0.44

VPlasC = 0.0428
VPlas_total = VPlasC*BW

; KIDNEY SUBCOMPARTMENT VOLUMES

Vfil = 0.10*VK

VPTCC = 0.000135
; L/g kidney

VPTC = VK*1000*VPTCC

FVBK = 0.24

VKblood = VK*FVBK
VKplasma = VKblood*(1-Htc)

VKpar = VK-VKblood-VPTC-Vfil

; Central plasma excludes explicitly represented renal plasma.

VPlas = VPlas_total-VKplasma

; AGE-DEPENDENT ORGAN BLOOD FLOWS

QBC50 = 0.12
QKC50 = 0.19
QLC50 = 0.255

; Literature absolute cerebral blood flow, mL/min.
; Used to calculate relative changes after age 50.

QB_ref_mL_min =
IF Age_phys <= 50 THEN 727.9
ELSE IF Age_phys <= 60 THEN 727.9+(692.9-727.9)*(Age_phys-50)/10
ELSE IF Age_phys <= 70 THEN 692.9+(650.6-692.9)*(Age_phys-60)/10
ELSE IF Age_phys <= 80 THEN 650.6+(623.8-650.6)*(Age_phys-70)/10
ELSE IF Age_phys <= 90 THEN 623.8+(594.4-623.8)*(Age_phys-80)/10
ELSE IF Age_phys <= 100 THEN 594.4+(536.1-594.4)*(Age_phys-90)/10
ELSE 536.1

QB_age_factor = QB_ref_mL_min/727.9

; Literature absolute renal blood flow, mL/min.

QK_ref_mL_min =
IF Age_phys <= 50 THEN 1116.3
ELSE IF Age_phys <= 60 THEN 1116.3+(913.3-1116.3)*(Age_phys-50)/10
ELSE IF Age_phys <= 70 THEN 913.3+(730.3-913.3)*(Age_phys-60)/10
ELSE IF Age_phys <= 80 THEN 730.3+(567.3-730.3)*(Age_phys-70)/10
ELSE IF Age_phys <= 90 THEN 567.3+(424.3-567.3)*(Age_phys-80)/10
ELSE IF Age_phys <= 100 THEN 424.3+(301.3-424.3)*(Age_phys-90)/10
ELSE 301.3

QK_age_factor = QK_ref_mL_min/1116.3

; Literature total hepatic blood flow, mL/min.

QL_ref_mL_min =
IF Age_phys <= 50 THEN 1661.6
ELSE IF Age_phys <= 60 THEN 1661.6+(1418.6-1661.6)*(Age_phys-50)/10
ELSE IF Age_phys <= 70 THEN 1418.6+(1091.6-1418.6)*(Age_phys-60)/10
ELSE IF Age_phys <= 80 THEN 1091.6+(819.7-1091.6)*(Age_phys-70)/10
ELSE IF Age_phys <= 90 THEN 819.7+(688.6-819.7)*(Age_phys-80)/10
ELSE IF Age_phys <= 100 THEN 688.6+(555.1-688.6)*(Age_phys-90)/10
ELSE 555.1

QL_age_factor = QL_ref_mL_min/1661.6

; AGE-50 MODEL REFERENCE FOR ORGAN BLOOD FLOWS
; These values follow the current anthropometric functions.
; Update them if the underlying age-50 anthropometry changes.

BW50_ref = mBW*72.05
HT50_ref = mHT*168.30

SA50_ref = 0.007184*(BW50_ref^0.425)*(HT50_ref^0.725)

QC50_blood_ref = mQC*(6.48370-1.59948*50+214.68572*SA50_ref)

QB50_blood_ref = mQBC*QBC50*QC50_blood_ref
QK50_blood_ref = mQKC*QKC50*QC50_blood_ref
QL50_blood_ref = mQLC*QLC50*QC50_blood_ref

; Through age 50:
; fixed reference fractions of current cardiac output.
;
; After age 50:
; model age-50 absolute flow times its literature age factor.

QB_blood =
IF Age_phys <= 50 THEN mQBC*QBC50*QC_blood
ELSE QB50_blood_ref*QB_age_factor

QK_blood =
IF Age_phys <= 50 THEN mQKC*QKC50*QC_blood
ELSE QK50_blood_ref*QK_age_factor

QL_blood =
IF Age_phys <= 50 THEN mQLC*QLC50*QC_blood
ELSE QL50_blood_ref*QL_age_factor

; Derived organ-flow fractions.

QBC = QB_blood/QC_blood
QKC = QK_blood/QC_blood
QLC = QL_blood/QC_blood

; Convert whole-blood flows to plasma flows.

QC = QC_blood*(1-Htc)
QB = QB_blood*(1-Htc)
QK = QK_blood*(1-Htc)
QL = QL_blood*(1-Htc)

QLu = QC
QRest = QC-QL-QK-QB

; AGE-DEPENDENT RENAL FILTRATION

eGFR_base =
IF Age_phys <= 24.5 THEN 113.94
ELSE IF Age_phys <= 34.5 THEN 113.94+(106.93-113.94)*(Age_phys-24.5)/10
ELSE IF Age_phys <= 44.5 THEN 106.93+(100.31-106.93)*(Age_phys-34.5)/10
ELSE IF Age_phys <= 54.5 THEN 100.31+(96.32-100.31)*(Age_phys-44.5)/10
ELSE IF Age_phys <= 64.5 THEN 96.32+(88.63-96.32)*(Age_phys-54.5)/10
ELSE IF Age_phys <= 74.5 THEN 88.63+(82.76-88.63)*(Age_phys-64.5)/10
ELSE 82.76

eGFR = meGFR*eGFR_base

GFR_mL_min = eGFR*SA/1.73
GFR = GFR_mL_min*60/1000

GFRC = GFR/VK

; REST-OF-BODY VOLUME

VRest = 0.93*BW-VL-VLu-VB-VK-VPlas

VLC = VL/BW
VKC = VK/BW
VLuC = VLu/BW
VBC = VB/BW
VfilC = Vfil/BW

QCC_equiv = QC_blood/(BWratio^0.75)

; MONTE CARLO CONTROL
;
; MC_on = 0: nominal deterministic baseline.
; MC_on = 1: random parameter sets.
;
; Distribution widths are uncertainty assumptions.
; They are not fitted confidence intervals.
;
; Bounds correspond to the parent-distribution
; 2.5th and 97.5th percentiles.
;
; Invalid parameter sets use nominal inputs for execution.
; Exclude ALL MC_valid = 0 runs from summaries.

MC_on = 1

MC_CV = 0.20
MC_CV_VL = 0.30

MC_sigma = SQRT(LOGN(1+MC_CV^2))
MC_z_limit = 1.95996398454005

; NOMINAL PARAMETER VALUES

VL_scale_base = 1

PL_base = 12.99
PRest_base = 0.32

KbileC_base = 0.000487
KabsC_base = 0.012
KunabsC_base = 0.000689

; LOG-SCALE PARAMETERS
; Nominal chemical inputs are arithmetic means
; of the untruncated parent distributions.

MC_mu_PL = LOGN(PL_base)-0.5*MC_sigma^2
MC_mu_PRest = LOGN(PRest_base)-0.5*MC_sigma^2

MC_mu_KbileC = LOGN(KbileC_base)-0.5*MC_sigma^2
MC_mu_KabsC = LOGN(KabsC_base)-0.5*MC_sigma^2
MC_mu_KunabsC = LOGN(KunabsC_base)-0.5*MC_sigma^2

; RANDOM DRAWS AT INITIALIZATION
; NORMAL(0,1) is a standard normal variate.
; Each draw remains fixed throughout one run.
; Do not assign the same fixed seed to all six calls.

VL_scalec = INIT(VL_scale_base+MC_CV_VL*VL_scale_base*NORMAL(0,1))

PLc = INIT(EXP(MC_mu_PL+MC_sigma*NORMAL(0,1)))
PRestc = INIT(EXP(MC_mu_PRest+MC_sigma*NORMAL(0,1)))

KbileCc = INIT(EXP(MC_mu_KbileC+MC_sigma*NORMAL(0,1)))
KabsCc = INIT(EXP(MC_mu_KabsC+MC_sigma*NORMAL(0,1)))
KunabsCc = INIT(EXP(MC_mu_KunabsC+MC_sigma*NORMAL(0,1)))

; SAMPLING BOUNDS

VL_scale_lower = VL_scale_base*(1-MC_z_limit*MC_CV_VL)
VL_scale_upper = VL_scale_base*(1+MC_z_limit*MC_CV_VL)

PL_lower = EXP(MC_mu_PL-MC_z_limit*MC_sigma)
PL_upper = EXP(MC_mu_PL+MC_z_limit*MC_sigma)

PRest_lower = EXP(MC_mu_PRest-MC_z_limit*MC_sigma)
PRest_upper = EXP(MC_mu_PRest+MC_z_limit*MC_sigma)

KbileC_lower = EXP(MC_mu_KbileC-MC_z_limit*MC_sigma)
KbileC_upper = EXP(MC_mu_KbileC+MC_z_limit*MC_sigma)

KabsC_lower = EXP(MC_mu_KabsC-MC_z_limit*MC_sigma)
KabsC_upper = EXP(MC_mu_KabsC+MC_z_limit*MC_sigma)

KunabsC_lower = EXP(MC_mu_KunabsC-MC_z_limit*MC_sigma)
KunabsC_upper = EXP(MC_mu_KunabsC+MC_z_limit*MC_sigma)

; VALIDITY OF EACH DRAW

MC_VL_ok =
IF VL_scalec >= VL_scale_lower AND VL_scalec <= VL_scale_upper
THEN 1 ELSE 0

MC_PL_ok =
IF PLc >= PL_lower AND PLc <= PL_upper
THEN 1 ELSE 0

MC_PRest_ok =
IF PRestc >= PRest_lower AND PRestc <= PRest_upper
THEN 1 ELSE 0

MC_KbileC_ok =
IF KbileCc >= KbileC_lower AND KbileCc <= KbileC_upper
THEN 1 ELSE 0

MC_KabsC_ok =
IF KabsCc >= KabsC_lower AND KabsCc <= KabsC_upper
THEN 1 ELSE 0

MC_KunabsC_ok =
IF KunabsCc >= KunabsC_lower AND KunabsCc <= KunabsC_upper
THEN 1 ELSE 0

; VALIDITY OF THE WHOLE PARAMETER SET

MC_valid =
IF MC_on = 0 THEN 1
ELSE MC_VL_ok*MC_PL_ok*MC_PRest_ok*MC_KbileC_ok*MC_KabsC_ok*MC_KunabsC_ok

; PARAMETER VALUES USED BY THE MODEL
; A rejected set uses all nominal inputs.
; Its outputs must still be removed using MC_valid.

VL_scale =
IF MC_on = 1 AND MC_valid = 1
THEN VL_scalec
ELSE VL_scale_base

PL =
IF MC_on = 1 AND MC_valid = 1
THEN PLc*PL_scale
ELSE PL_base*PL_scale

PRest =
IF MC_on = 1 AND MC_valid = 1
THEN PRestc*PRest_scale
ELSE PRest_base*PRest_scale

KbileC =
IF MC_on = 1 AND MC_valid = 1
THEN KbileCc
ELSE KbileC_base

KabsC =
IF MC_on = 1 AND MC_valid = 1
THEN KabsCc
ELSE KabsC_base

KunabsC =
IF MC_on = 1 AND MC_valid = 1
THEN KunabsCc
ELSE KunabsC_base

; OTHER PARTITION AND BINDING PARAMETERS

PK_exchange_seed = 1.38

; Exchange-pool seed only.
; This is not a fitted whole-kidney partition coefficient.

PKpar_start = (PK_exchange_seed*VK-VKplasma)/VKpar

PKpar_scale = 1
PKpar = PKpar_start*PKpar_scale

PLu = 4.58
PB = 0.14

MW = 532.58
Free = 0.0043

; RENAL TRANSPORT PARAMETERS
; Fixed human-model inputs in this MC analysis.

Vmax_baso_invitro = 479
Km_baso = 20.1

Vmax_apical_invitro = 51803
Km_apical = 64.4

RAFbaso = 1
RAFapi = 0.001

Kdif = 0.001
KeffluxC = 2.09
KurineC = 0.000016

protein = 2.0E-6

; FIXED GI PARAMETERS
; KabsC, KunabsC and KbileC are assigned above.

K0C = 0.38
GEC = 3.5

; TRANSPORTER SCALING

PTC_cells_perkg = VKC*1000*6E7

Vmax_basoC = Vmax_baso_invitro*RAFbaso*PTC_cells_perkg*protein*60*(MW/1E12)*1000

Vmax_apicalC = Vmax_apical_invitro*RAFapi*PTC_cells_perkg*protein*60*(MW/1E12)*1000

Vmax_baso = Vmax_basoC*(BWratio^0.75)
Vmax_apical = Vmax_apicalC*(BWratio^0.75)

; FIRST-ORDER RATE SCALING
; Sampled coefficients remain fixed within each run.
; Actual rates change with age-dependent body weight.

Kbile = KbileC*(BWratio^-0.25)
Kurine = KurineC*(BWratio^-0.25)
Kefflux = KeffluxC*(BWratio^-0.25)

Kabs = KabsC*(BWratio^-0.25)
Kunabs = KunabsC*(BWratio^-0.25)

GE = GEC*(BWratio^-0.25)
K0 = K0C*(BWratio^-0.25)

; OPTIONAL ADDITIONAL SYSTEMIC PARENT LOSS

HL_target_day = 5588

; Literature reference only.
; This parameter does not set Ksys.

Ksys_extra_h = 0
Ksys = Ksys_extra_h

; INITIAL BACKGROUND BURDEN AT AGE 20
; Initial plasma concentration is fixed.
; Tissue initialization uses the current run's partition coefficients.
; PTC and filtrate initial amounts are zero.

C0_plasma_ng_mL = 0.57
C0_plasma_mg_L = C0_plasma_ng_mL/1000

C0_liver_mg_L = PL*C0_plasma_mg_L
C0_kidney_par_mg_L = PKpar*C0_plasma_mg_L

C0_lung_mg_L = PLu*C0_plasma_mg_L
C0_brain_mg_L = PB*C0_plasma_mg_L
C0_rest_mg_L = PRest*C0_plasma_mg_L

RKE0 = C0_plasma_mg_L*VKplasma+C0_kidney_par_mg_L*VKpar

; AGE-STRATIFIED DAILY EXPOSURE

Dose18_50_mgkgd = 1.22E-7

Dose50_65_mgkgd = Dose18_50_mgkgd*(2450/2600)
Dose65_80_mgkgd = Dose18_50_mgkgd*(2350/2600)

Dose_mgkgd =
IF Age_year < 50 THEN Dose18_50_mgkgd
ELSE IF Age_year < 65 THEN Dose50_65_mgkgd
ELSE Dose65_80_mgkgd

Exposure_on =
IF Age_year < Exposure_start_age THEN 0 ELSE 1

Daily_dose_mg = Exposure_on*Dose_mgkgd*BW_dose

Dose_interval_h = 24
Exposure_start_h = (Exposure_start_age-Age_start_year)*365*24

; Require:
; Age_start_year <= Exposure_start_age < Age_end_year.
; Default ages correspond to an integer number of exposure days.

Pulse_gate_stop_h = Stoptime-Dose_interval_h/2

Dose_event_rate =
IF TIME < Pulse_gate_stop_h
THEN PULSE(1,Exposure_start_h,Dose_interval_h)
ELSE 0

DoseInput = Daily_dose_mg*Dose_event_rate

ADOSE' = DoseInput
INIT ADOSE = 0

DoseCount' = Dose_event_rate
INIT DoseCount = 0

Expected_dose_count = (Stoptime-Exposure_start_h)/Dose_interval_h

Dose_count_error = DoseCount-Expected_dose_count

; Interpret dose-count error at the simulation endpoint.
; Default schedule: 16425 doses.
; The final scheduled dose is 24 h before the endpoint.

; TOTAL PLASMA CONCENTRATIONS

CA = RA/(VPlas*0.2)
CV = RV/(VPlas*0.8)

CA_free = Free*CA
CV_free = Free*CV

Cplas = (RA+RV)/VPlas

; LIVER CONCENTRATIONS

CL = RL/VL
CVL = CL/PL

CVL_free = Free*CVL

; RENAL EXCHANGE AND OBSERVATION

Kidney_partition_den = VKplasma+PKpar*VKpar

CVK = RKE/Kidney_partition_den
CVK_free = Free*CVK

CKpar = PKpar*CVK

A_Kvascular = CVK*VKplasma
A_Kpar = CKpar*VKpar

Kidney_partition_check = RKE-A_Kvascular-A_Kpar

PK_exchange_actual = Kidney_partition_den/VK

CPTC = RPTC/VPTC
Cfil = RFil/Vfil

Kidney_amount_observed = RKE+RPTC+RFil-KidneyPerfused*A_Kvascular

CK = Kidney_amount_observed/VK

Whole_kidney_to_CVK =
IF CVK > 0 THEN CK/CVK ELSE 0

; LUNG, BRAIN AND REST CONCENTRATIONS

CLu = RLu/VLu
CVLu = CLu/PLu

CVLu_free = Free*CVLu

CB = RB/VB
CVB = CB/PB

CVB_free = Free*CVB

CRest = RRest/VRest
CVRest = CRest/PRest

CVRest_free = Free*CVRest

; RENAL TRANSPORT RATES

Rate_baso = Vmax_baso*CVK/(Km_baso+CVK)

Rate_apical = Vmax_apical*Cfil/(Km_apical+Cfil)

Rate_dif = Kdif*(CVK-CPTC)

Rate_efflux = Kefflux*RPTC

Rate_GFR = CA_free*GFR

Cum_baso' = Rate_baso
INIT Cum_baso = 0

Cum_apical' = Rate_apical
INIT Cum_apical = 0

Cum_dif' = Rate_dif
INIT Cum_dif = 0

Cum_efflux' = Rate_efflux
INIT Cum_efflux = 0

Cum_GFR' = Rate_GFR
INIT Cum_GFR = 0

; Cumulative renal transport is not irreversible elimination.

; ADDITIONAL LOSS ACCOUNTING

Systemic_mass_for_loss = RA+RV+RRest+RKE+RPTC+RL+RLu+RB

Rate_sysloss = Ksys*Systemic_mass_for_loss

Rsysloss' = Rate_sysloss
INIT Rsysloss = 0

; DIFFERENTIAL EQUATIONS

RV' = QRest*CVRest+QK*CVK+QL*CVL+QB*CVB-QLu*CV-Ksys*RV
INIT RV = C0_plasma_mg_L*VPlas*0.8

RA' = QLu*CVLu-QC*CA-Ksys*RA
INIT RA = C0_plasma_mg_L*VPlas*0.2

RKE' = QK*(CA-CVK)-Rate_GFR-Rate_dif-Rate_baso+Rate_efflux-Ksys*RKE
INIT RKE = RKE0

RPTC' = Rate_dif+Rate_apical+Rate_baso-Rate_efflux-Ksys*RPTC
INIT RPTC = 0

RFil' = Rate_GFR-Rate_apical-Kurine*RFil
INIT RFil = 0

Rurine' = Kurine*RFil
INIT Rurine = 0

RRest' = QRest*(CA-CVRest)-Ksys*RRest
INIT RRest = C0_rest_mg_L*VRest

RLu' = QLu*(CV-CVLu)-Ksys*RLu
INIT RLu = C0_lung_mg_L*VLu

RB' = QB*(CA-CVB)-Ksys*RB
INIT RB = C0_brain_mg_L*VB

RST' = DoseInput-K0*RST-GE*RST
INIT RST = 0

RSI' = GE*RST-Kabs*RSI-Kunabs*RSI+Kbile*RL
INIT RSI = 0

RL' = QL*(CA-CVL)-Kbile*RL+Kabs*RSI+K0*RST-Ksys*RL
INIT RL = C0_liver_mg_L*VL

Rfeces' = Kunabs*RSI
INIT Rfeces = 0

; INTERNAL TRANSFER DIAGNOSTICS

RabsST' = K0*RST
INIT RabsST = 0

RabsSI' = Kabs*RSI
INIT RabsSI = 0

Total_oral_uptake = RabsSI+RabsST

Rbile' = Kbile*RL
INIT Rbile = 0

; Biliary transfer enters the intestine.
; Do not count Rbile again as terminal loss.

; INITIAL BURDEN AND MASS BALANCE

Qbal = QC-QL-QK-QRest-QB

Tmass = RA+RV+RRest+RKE+RFil+RPTC+RL+RST+RSI+RLu+RB

Loss = Rurine+Rfeces+Rsysloss

Initial_body_burden' = 0

INIT Initial_body_burden = C0_plasma_mg_L*VPlas+RKE0+C0_rest_mg_L*VRest+C0_liver_mg_L*VL+C0_lung_mg_L*VLu+C0_brain_mg_L*VB

Input = Initial_body_burden+ADOSE

Bal = Input-Tmass-Loss

Mass_recovery_pct =
IF Input > 0
THEN 100*(Tmass+Loss)/Input
ELSE 0

Mass_balance_abs_error_pct =
IF Input > 0
THEN 100*ABS(Bal)/Input
ELSE 0

ln_Cplas =
IF Cplas > 0 THEN LOGN(Cplas) ELSE -999

; Mass balance is a numerical consistency diagnostic.
; It does not validate biological elimination pathways.
; No terminal half-life is estimated from this exposure run.

; GENERAL OUTPUTS

VP = CV
